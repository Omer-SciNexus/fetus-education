# Cloudflare Pages security headers (section 16).
# connect-src must include your Supabase project URL; update before deploying.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://*.supabase.co http://127.0.0.1:54321; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.supabase.co; object-src 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets can be cached long-term. Never cache HTML or private data.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
