# Copy to .env.local. Only PUBLIC values belong here — everything prefixed VITE_
# is compiled into the browser bundle.

# Supabase project URL and publishable (anon) key.
# Local values are printed by `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Shows an email/password form on /sign-in for LOCAL development only.
# Never enable on the hosted pilot — production sign-in is Google only.
VITE_ENABLE_DEV_LOGIN=true

# Owner-controlled support mailbox shown on /help.
VITE_SUPPORT_EMAIL=support@example.com

# Version of the privacy notice and pilot terms that onboarding records consent to.
VITE_POLICY_VERSION=2026-10-31

# NEVER put the service role key, database password or Google client secret here.
